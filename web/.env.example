# Copy to .env.local (git-ignored) and fill in. NEVER commit real values.
# Development without credentials: MOCK_MODE=1 (no staff login; a random device token is kept in .data/)
MOCK_MODE=1

# Anything else is "prod" mode and fails closed unless ALL three are set:
# STAFF_PASSWORD=at-least-12-characters
# SESSION_SECRET=32+ random characters (openssl rand -hex 32)
# DEVICE_TOKEN=32+ random characters (openssl rand -hex 32)
# DEVICE_ID=reception-1
# ALLOWED_ORIGINS=https://control.example.org
# DATA_DIR=/absolute/path/for/the/dev/json/file
